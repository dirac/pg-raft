
path-constant TOP_DIR : . ;

project pg_raft
    : requirements
      <include>.
      <link>static
      <cxxstd>23
      <debug-symbols>on
      <cxxflags>-DBOOST_ASIO_NO_DEPRECATED=1
      <cxxflags>-DTOP_DIR="$(TOP_DIR)"
      <variant>debug:<cxxflags>-Wextra
      <variant>debug:<cxxflags>-Wconversion
      <variant>debug:<cxxflags>-Wuninitialized
      <variant>debug:<cxxflags>-Wno-non-virtual-dtor
      <variant>debug:<cxxflags>-ftemplate-backtrace-limit=0
      <cxxflags>-Wall
      <cxxflags>-Werror
      <cxxflags>-isystem/opt/pg_raft/include
      <cxxflags>-isystem/usr/local/include
      <warnings>all
      <visibility>hidden
      <address-sanitizer>norecover:<cxxflags>-DUSE_ASAN=1
      <thread-sanitizer>norecover:<cxxflags>-DUSE_TSAN=1
      <thread-sanitizer>norecover:<cxxflags>-Wno-tsan
    ;


using testing ;

lib boost_json            : : <name>boost_json            <search>/opt/pg_raft/lib/ ;
lib boost_filesystem      : : <name>boost_filesystem      <search>/opt/pg_raft/lib/ ;
lib boost_thread          : : <name>boost_thread          <search>/opt/pg_raft/lib/ ;
lib boost_serialization   : : <name>boost_serialization   <search>/opt/pg_raft/lib/ ;

lib boost_unit_test_framework  : : <name>boost_unit_test_framework <search>/opt/pg_raft/lib/ ;

lib lmdb : : <name>lmdb <search>/opt/pg_raft/lib/ ;
lib fuse : : <name>fuse <search>/usr/local/lib ;

lib ssl    : : <name>ssl    <search>/opt/pg_raft/lib/ <search>/opt/pg_raft/lib64 ;
lib crypto : : <name>crypto <search>/opt/pg_raft/lib/ <search>/opt/pg_raft/lib64 ;

alias external :
    boost_json
    boost_filesystem
    boost_serialization
    lmdb
    fuse
    ssl
    crypto
  ;

alias external_test
   : boost_unit_test_framework
     external
   ;

build-project src ;

